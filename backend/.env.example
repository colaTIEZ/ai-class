# ai-class backend env template
# Copy this file to backend/.env before running backend with uv.

# App
APP_NAME=ai-class
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# Persistence
# Phase 1 prefers PostgreSQL. Keep DATABASE_PATH for local SQLite fallback.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_class
DATABASE_PATH=data/ai_class.db

# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=knowledge_chunks

# Object storage (local for dev)
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=ai-class-dev
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_LOCAL_ROOT=backend/data/object_store

# Tenant defaults
DEFAULT_TENANT_ID=local-dev

# Optional Redis-ready config (future async/cache use)
REDIS_URL=redis://localhost:6379/0

# LLM
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_FALLBACK_MODEL=