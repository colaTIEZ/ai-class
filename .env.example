# ai-class infra env template
# Copy this file to .env at repo root before `docker compose -f docker-compose.infra.yml up -d`.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_class
POSTGRES_PORT=5432

# Milvus and dependencies
MILVUS_PORT=19530
MILVUS_HTTP_PORT=9091
ETCD_PORT=2379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Optional Redis profile
REDIS_PORT=6379
